    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/check-site.test.mjs",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "verify": "pnpm check && pnpm build && pnpm test"
  },
  "dependencies": {
    "@retorquere/bibtex-parser": "11.0.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.5",
    "typescript": "~5.9.3"
  }
}
