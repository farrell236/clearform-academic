---
import Icon from './Icon.astro';
import { url } from '../lib/urls';

interface Props {
  id: string;
  title: string;
  actionLabel: string;
  href: string;
}

const { id, title, actionLabel, href } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  <a class="text-link" href={url(href)}>{actionLabel}<Icon /></a>
</div>
