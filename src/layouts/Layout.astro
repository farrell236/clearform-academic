---
import '../styles/global.css';
import { contentFormatVersion, demoContent, isPreview, navigation, profile, site } from '../config';
import { url } from '../lib/urls';
import { assertContentFormat } from '../lib/content-contract';
import Profile from '../components/Profile.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  kind?: 'website' | 'article';
  published?: Date;
}

const { title, description = profile.introduction, kind = 'website', published } = Astro.props;
assertContentFormat(contentFormatVersion);
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.discipline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(url('/social-preview.png'), Astro.site);
const current = (href: string) => href === '/' ? Astro.url.pathname === url('/') : Astro.url.pathname.startsWith(url(href));
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: new URL(url('/'), Astro.site).href,
  sameAs: profile.links.filter(link => /^https?:\/\//.test(link.href)).map(link => link.href),
};
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="robots" content={isPreview ? 'noindex, nofollow' : 'index, follow'} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:type" content={kind} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.discipline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {!demoContent && current('/') && <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="home-link" href={url('/')} aria-current={current('/') ? 'page' : undefined}>
          <Icon name="home" />
          <span>Home</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(item => (
            <a href={url(item.href)} aria-current={current(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <details class="mobile-menu">
          <summary>
            Menu
            <Icon name="menu" />
          </summary>
          <nav aria-label="Main navigation">
            {navigation.map(item => (
              <a href={url(item.href)} aria-current={current(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <div class="site-shell">
      <Profile />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <span>© {new Date().getUTCFullYear()} {profile.name}</span>
    </footer>
  </body>
</html>
