---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../config';
import { aboutPage } from '../data/pages';
import { url } from '../lib/urls';
---
<Layout title="About" description={aboutPage.metaDescription}>
  <PageHeading
    title={aboutPage.title}
    description={`I am ${profile.name}, ${aboutPage.introduction}`}
  />
  <article class="panel prose">
    {aboutPage.sections.map(section => (
      <section>
        <h2>{section.title}</h2>
        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </section>
    ))}
    <a class="text-link" href={url(profile.cv)} download>
      {aboutPage.cvLabel}<Icon name="download" />
    </a>
  </article>
  <section class="panel contact-panel" aria-labelledby="contact">
    <h2 id="contact">{aboutPage.contactTitle}</h2>
    <p>{aboutPage.contactText}</p>
    <div class="resource-links">
      <a class="button button-primary" href={`mailto:${profile.email}`}>
        <Icon name="mail" />Email {profile.name}
      </a>
      {profile.links.map(link => (
        <a class="button button-secondary" href={url(link.href)}>
          {link.label}<Icon name="arrow-up-right" />
        </a>
      ))}
    </div>
  </section>
</Layout>
