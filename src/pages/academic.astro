---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { academicPage } from '../data/pages';
import { url } from '../lib/urls';
---
<Layout title="Academic" description={academicPage.metaDescription}>
  <PageHeading title={academicPage.title} description={academicPage.description} />
  <section class="panel" aria-labelledby="talks">
    <h2 id="talks">Talks</h2>
    {academicPage.talks.map(talk => (
      <article class="academic-row">
        <h3>{talk.title}</h3>
        <p>{talk.context}</p>
        <a
          class="text-link"
          href={url(talk.href)}
          aria-label={`View sample slides: ${talk.title}`}
        >
          View sample slides<Icon name="arrow-up-right" />
        </a>
      </article>
    ))}
  </section>
  <section class="panel" aria-labelledby="teaching">
    <h2 id="teaching">Teaching</h2>
    {academicPage.teaching.map(item => (
      <div class="academic-row">
        <h3>{item.title}</h3>
        {item.details.map(detail => <p>{detail}</p>)}
      </div>
    ))}
  </section>
  <p class="archive-notice">{academicPage.notice}</p>
</Layout>
